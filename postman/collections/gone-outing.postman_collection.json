                  "    pm.expect(body.code).to.eql(\"OUTING_006\");",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "rejectedReason 빈 값 → 400",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{teacherAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rejectedReason\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/outings/{{outingCode}}/reject",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "outings",
                "{{outingCode}}",
                "reject"
              ]
            },
            "description": "Bean Validation(@NotBlank)에서 걸러져야 합니다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "response": []
