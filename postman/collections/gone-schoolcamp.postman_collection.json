            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{teacherAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/school-camps",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "school-camps"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"campDates\": [\n    \"{{campDate1}}\",\n    \"{{campDate2}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4. 캘린더 조회 (등록한 날짜가 OPEN으로 보이는지 확인)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/school-camps?month={{schoolCampMonth}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "school-camps"
              ],
              "query": [
                {
                  "key": "month",
                  "value": "{{schoolCampMonth}}"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"등록한 날짜가 목록에 있고 상태가 OPEN이다\", function () {",
                  "    const body = pm.response.json();",
                  "    const found = body.data.find(",
                  "        s => s.campDate === pm.environment.get(\"campDate1\"));",
                  "    pm.expect(found).to.not.be.undefined;",
                  "    pm.expect(found.status).to.eql(\"OPEN\");",
                  "    pm.expect(found.teacherDisplayName).to.be.null;",
                  "    pm.expect(found.applicantDisplayName).to.be.null;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
